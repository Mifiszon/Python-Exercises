   "source": [
    "n = int(input('Podaj liczbę:'))\n",
    "\n",
    "def fibonacci(n):\n",
    "    first = 0\n",
    "    second = 1\n",
    "    while first <= n:\n",
    "        yield first\n",
    "        first, second = second, first + second\n",
    "\n",
    "for x in fibonacci(n):\n",
    "    print(x)"
   ]
  }
