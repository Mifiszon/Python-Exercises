   ],
   "source": [
    "def pairwise(iterable):\n",
    "    for i in range(len(iterable) - 1):\n",
    "        yield (iterable[i], iterable[i + 1])\n",
    "\n",
    "list(pairwise([10, 20, 30, 40]))  # [(10, 20), (20, 30), (30, 40)]"
   ]
  }
 ],
