   "source": [
    "def counter():\n",
    "    num = 1\n",
    "    sum = 0\n",
    "    while sum <= 100:\n",
    "        yield num\n",
    "        sum += num\n",
    "        num += 1\n",
    "\n",
    "for x in counter():\n",
    "    print(x)"
   ]
  }
 ],
